# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Supabase (new API key system) ────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key — safe for frontend use
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER SIDE ONLY, never expose to client
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── Google Gemini ────────────────────────────────────────
# SERVER SIDE ONLY
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Calendar OAuth 2.0 ────────────────────────────
# SERVER SIDE ONLY — Salon Owner Calendar Authorization
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary

# ─── Admin ────────────────────────────────────────────────
# Simple admin passphrase for local/demo access
ADMIN_PASSPHRASE=admin123

# ─── Timezone ─────────────────────────────────────────────
TZ=Asia/Kolkata
