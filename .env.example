# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Supabase (new API key system) ────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key — safe for frontend use
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER SIDE ONLY, never expose to client
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── Google Gemini ────────────────────────────────────────
# SERVER SIDE ONLY
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Admin ────────────────────────────────────────────────
# Simple admin passphrase for MVP (no full auth system yet)
ADMIN_PASSPHRASE=changeme

# ─── Timezone ─────────────────────────────────────────────
# All appointment times are stored and interpreted in this timezone
TZ=Asia/Kolkata
